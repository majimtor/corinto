// The environment that the Codespaces link of the README opens. It runs the
// same command as a local run, with nothing to install.
{
  "name": "Corinto",

  // No image is named on purpose: Codespaces then uses its default image,
  // which brings Docker. PLAN.md section 20 records that dependency.

  // Runs on every start of the codespace, the first one and each resume, so
  // that the stack is up whenever the editor is.
  "postStartCommand": "make up",

  // The ports of the processes: the management API and the host of the
  // short links, each with its /livez and /readyz next to it, and the
  // /livez and /readyz of the worker.
  "forwardPorts": [8080, 8081, 8082, 8083, 8084],
  "portsAttributes": {
    "8080": {
      "label": "Management API",
      "onAutoForward": "silent"
    },
    "8081": {
      "label": "Health endpoints of the API",
      // Listed in the Ports panel, without a notification on every start.
      "onAutoForward": "silent"
    },
    "8082": {
      "label": "Short links",
      "onAutoForward": "silent"
    },
    "8083": {
      "label": "Health endpoints of the short links",
      "onAutoForward": "silent"
    },
    "8084": {
      "label": "Health endpoints of the worker",
      "onAutoForward": "silent"
    }
  }
}
