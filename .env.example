# The variables the binary reads. Their values differ between installations
# and are never versioned. The local stack sets them in deploy/compose.yaml.

# Connection URL of the PostgreSQL database, credentials included. Every
# process reads it; the worker process reads nothing else but the address
# of its health endpoints.
CORINTO_DATABASE_URL=

# Address on which the api process serves the management API, for example
# :8080.
CORINTO_API_ADDR=

# Address on which the redirect process answers on the host of the short
# links, for example :8082.
CORINTO_REDIRECT_ADDR=

# Optional. The proxies in front of the api and redirect processes whose
# X-Forwarded-For header is believed when the address of a client is asked
# for: addresses and networks separated by commas, for example
# 10.0.0.0/8,192.0.2.10. Empty means that the address of a client is the one
# of its connection.
CORINTO_TRUSTED_PROXIES=

# Address on which the process answers /livez and /readyz, for example :8081.
CORINTO_HEALTH_ADDR=

# Host that serves the short links, for example go.example.com. A link is
# stored with it, so the api process needs it to create one, the redirect
# process to load its own, and `corinto operator block-link` to find one.
CORINTO_REDIRECT_DOMAIN=
