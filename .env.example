# The variables the binary reads. Their values differ between installations
# and are never versioned. The local stack sets them in deploy/compose.yaml.

# Connection URL of the PostgreSQL database, credentials included.
CORINTO_DATABASE_URL=

# Address on which the process answers /livez and /readyz, for example :8081.
CORINTO_HEALTH_ADDR=

# Host that serves the short links, for example go.example.com. A link is
# stored with it. So far only `corinto operator block-link` reads it, and
# the local stack does not set it yet: nothing there creates links.
CORINTO_REDIRECT_DOMAIN=
