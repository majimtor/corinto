# A Node that is not the one of .node-version fails the installation instead
# of warning (docs/engineering-rules.md, "Environment and lockfiles"), and a
# dependency is written with its exact version.
engine-strict=true
save-exact=true
# No package runs a script of its own when it is installed. The browsers
# are downloaded by the command that says so, `playwright install`.
ignore-scripts=true
